.ac-card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-card);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--sh);
}
.ac-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; }
.fav {
  width: 72rpx; height: 72rpx; border-radius: 20rpx;
  border: 1rpx solid var(--line); background: var(--surface-2);
  display: flex; align-items: center; justify-content: center; color: var(--ink-3);
}
.fav.on { color: var(--accent); border-color: var(--accent-soft); background: var(--accent-soft); }
.ac-title { font-size: 34rpx; font-weight: 700; color: var(--ink); line-height: 1.4; margin-bottom: 18rpx; }
.meta { display: flex; align-items: center; gap: 12rpx; color: var(--ink-2); font-size: 30rpx; margin-bottom: 10rpx; }
.meta .dist { color: var(--primary-d); font-weight: 700; }
