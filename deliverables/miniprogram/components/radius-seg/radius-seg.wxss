.rseg-wrap { display: flex; gap: 16rpx; }
.rseg {
  flex: 1; border: 1rpx solid rgba(255,255,255,.4); background: rgba(255,255,255,.08);
  color: #fff; border-radius: 20rpx; padding: 16rpx 4rpx;
  display: flex; flex-direction: column; align-items: center; gap: 4rpx;
  font-size: 30rpx; font-weight: 700;
}
.rseg .rcnt { font-size: 20rpx; font-weight: 600; opacity: .85; }
.rseg.on { background: #fff; color: var(--primary); border-color: #fff; }
.rseg.on .rcnt { color: var(--accent-d); }
