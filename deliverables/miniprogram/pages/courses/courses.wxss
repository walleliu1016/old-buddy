.page { padding-bottom: var(--sp-4); }

.chero {
  margin: 0; padding: var(--sp-4) var(--sp-4) var(--sp-3);
  background: var(--grad-hero);
  color: #fff; border-radius: 0 0 var(--r-box) var(--r-box);
}
.chero .ch-title { display: flex; align-items: center; gap: 10rpx; font-size: var(--fs-hero); font-weight: 800; }
.chero .ch-sub { font-size: var(--fs-sub); opacity: .9; margin-top: var(--sp-2); line-height: 1.6; white-space: pre-line; }

/* 分类条：吸顶 + 横滑（chip 视觉用全局 .chip） */
.catbar { position: sticky; top: 0; z-index: 20; background: var(--bg); white-space: nowrap; padding: var(--sp-3) var(--sp-3) var(--sp-2); }
.catbar .chip { margin-right: var(--sp-2); }

.feed { padding: var(--sp-1) var(--sp-3); }
.feed .card { margin-bottom: var(--sp-3); }
.feed .card:active { transform: scale(.985); }

.course .c-top { display: flex; align-items: center; justify-content: space-between; }
.kind-badge { font-size: var(--fs-cap); font-weight: 700; color: var(--primary-d); background: var(--primary-soft); padding: 6rpx 18rpx; border-radius: var(--r-pill); }
.course .ttl { font-size: var(--fs-title); font-weight: 800; color: var(--ink); margin: var(--sp-2) 0 14rpx; line-height: 1.4; }
.course .meta { display: flex; align-items: center; gap: 12rpx; font-size: var(--fs-sub); color: var(--ink-2); margin-top: 10rpx; }
.course .meta .dist { color: var(--primary-d); font-weight: 700; }
.course .cfoot { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: var(--sp-2); }
.course .seats { display: inline-flex; align-items: center; gap: 8rpx; font-size: var(--fs-sub); font-weight: 700; color: var(--ink-2); }
.course .seats.low { color: var(--accent-d); }
.course .deadline { font-size: var(--fs-cap); color: var(--ink-3); }
.course .fee { margin-top: var(--sp-2); }
.booked-flag { display: inline-flex; align-items: center; gap: 6rpx; margin-top: var(--sp-2); font-size: var(--fs-cap); font-weight: 700; color: var(--free); background: var(--free-soft); padding: 8rpx 18rpx; border-radius: var(--r-pill); }

.src-note { margin: var(--sp-2) var(--sp-4) var(--sp-1); font-size: var(--fs-cap); color: var(--ink-3); line-height: 1.7; text-align: center; }
