<view class="page {{bigFont?'big':''}}">
  <view class="chero">
    <view class="ch-title"><view class="i-bookOpen i-22"></view>长期课 · 全城选课</view>
    <view class="ch-sub">需要报名入学、有固定课时与开班时间的课程。\n不受距离限制，按离您由近到远排列。</view>
  </view>

  <scroll-view scroll-x class="chips" enable-flex>
    <view wx:for="{{categories}}" wx:key="key" class="chip {{item.key===courseCat?'on':''}}" bindtap="onCat" data-cat="{{item.key}}">{{item.label}}</view>
  </scroll-view>

  <view class="sec-title"><view class="bar"></view>{{catLabel}}课程 · 共 {{list.length}} 门</view>
  <view class="hint">点卡片看课时安排、名额与报名</view>
  <view class="feed">
    <view wx:for="{{list}}" wx:key="id" class="card course" bindtap="onCardTap" data-id="{{item.id}}">
      <view class="c-top">
        <view class="tag"><view class="i-bookOpen i-22"></view><text>{{item.type}}</text></view>
        <view class="kind-badge">长期课</view>
      </view>
      <view class="ttl">{{item.title}}</view>
      <view class="meta"><view class="i-clock i-24"></view><text>{{item.schedule||item.time}}</text></view>
      <view class="meta"><view class="i-calendar i-24"></view><text>{{item.weeks}} · {{item.start}}</text></view>
      <view class="meta"><view class="i-mapPin i-24"></view><text><text class="dist">{{item.distance_km}}km</text> · {{item.venue}}</text></view>
      <view class="cfoot">
        <view class="seats"><view class="i-user i-24"></view>{{item.seats}}</view>
        <view class="deadline">{{item.deadline}}</view>
      </view>
      <view class="fee {{item.free?'free':'paid'}}">{{item.fee}}</view>
      <view wx:if="{{item.booked}}" class="booked-flag"><view class="i-check i-24"></view>已报名</view>
    </view>
    <view wx:if="{{list.length===0 && !loading}}" class="empty">
      <view class="eico"><view class="i-search i-30"></view></view>
      该分类下暂无长期课。
    </view>
  </view>
  <view class="src-note">课程由 AI 自动聚合老年大学 / 文化馆 / 社区学校公开课程（演示数据）</view>
</view>
