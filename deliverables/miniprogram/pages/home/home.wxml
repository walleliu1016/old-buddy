<view class="page {{bigFont?'big':''}}">
  <view class="hero">
    <view class="hero-top">
      <view class="greet">{{greeting}}，老朋友</view>
      <view class="loc-pill" bindtap="onLocate"><view class="i-mapPin-w i-20"></view><text>{{locationName}}</text></view>
    </view>
    <view class="sub"><view class="i-compass-w i-22"></view><text>附近的单次活动</text><text class="dot">·</text><view class="i-navigation-w i-22"></view><text>按离您由近到远</text></view>
  </view>

  <!-- 吸顶快捷分类条 -->
  <view class="quickbar">
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="quick-scroll">
      <view class="quick-row">
        <view wx:for="{{categories}}" wx:key="key" class="chip {{item.key===fselCat?'on':''}}" bindtap="onQuickCat" data-cat="{{item.key}}">{{item.label}}</view>
      </view>
    </scroll-view>
    <view class="qfilter" bindtap="openFilter"><view class="i-sliders i-22"></view><text>筛选</text></view>
  </view>

  <view class="sec-title"><view class="bar"></view>附近 · 本周活动</view>
  <view class="hint">共 {{feed.length}} 场 · 附近 {{radius}}km，点卡片看详情、收藏或报名</view>
  <view class="feed">
    <block wx:if="{{loading}}">
      <view class="skl-card" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="skl skl-title"></view>
        <view class="skl skl-line"></view>
        <view class="skl skl-line short"></view>
      </view>
    </block>
    <block wx:else>
      <activity-card wx:for="{{feed}}" wx:key="id" activity="{{item}}" fav="{{item.fav}}" bind:tap="onCardTap" bind:fav="onCardFav"/>
    </block>
    <view wx:if="{{feed.length===0 && !loading}}" class="empty">
      <view class="eico"><view class="i-search i-30"></view></view>
      附近 {{radius}}km 内暂无符合条件的活动，换个筛选或稍后再来看看。
    </view>
  </view>
  <view class="src-note">「附近」只收单次活动（讲座 / 演出 / 展览 / 市集 / 便民）。<br/>需要报名入学的长期课，请看底部「课程」。</view>

  <!-- 发布入口 -->
  <view class="fab" bindtap="goPublish"><text class="fab-plus">＋</text><text>发布</text></view>

  <view wx:if="{{showFilter}}" class="sheet-overlay" bindtap="closeFilter">
    <view class="sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-title">筛选条件</view>
      <view class="sheet-sec">
        <view class="ss-label">距离</view>
        <view class="chips">
          <view wx:for="{{radii}}" wx:key="*this" class="chip {{item===fselRadius?'on':''}}" bindtap="pickRadius" data-r="{{item}}">{{item}}km</view>
        </view>
      </view>
      <view class="sheet-sec">
        <view class="ss-label">分类</view>
        <view class="chips">
          <view wx:for="{{categories}}" wx:key="key" class="chip {{item.key===fselCat?'on':''}}" bindtap="pickCat" data-cat="{{item.key}}">{{item.label}}</view>
        </view>
      </view>
      <view class="sheet-acts">
        <view class="sbtn reset" bindtap="resetFilter">重置</view>
        <view class="sbtn ok" bindtap="applyFilter">查看结果</view>
      </view>
    </view>
  </view>
</view>
