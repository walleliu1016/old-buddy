.page { padding-bottom: 24rpx; }

/* Hero */
.hero {
  margin: 24rpx 24rpx 6rpx;
  background: var(--grad-hero);
  border-radius: var(--r-card); padding: 24rpx 32rpx 28rpx; color: #fff;
  position: relative; overflow: hidden;
  display: flex; flex-direction: column;
  box-shadow: var(--sh-sm);
}
.hero::after {
  content: ""; position: absolute; right: -60rpx; top: -60rpx;
  width: 220rpx; height: 220rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,.18), transparent 70%);
}
.hero-top { position: relative; z-index: 1; display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.greet { flex: 1; min-width: 0; font-size: var(--fs-hero); font-weight: 800; line-height: 1.25; }
.loc-pill {
  flex: 0 0 auto; margin-top: 6rpx;
  display: inline-flex; align-items: center; gap: 8rpx;
  max-width: 40vw; padding: 10rpx 22rpx; border-radius: var(--r-pill);
  background: rgba(255,255,255,.22); color: #fff;
  font-size: var(--fs-cap); font-weight: 700;
}
.loc-pill:active { background: rgba(255,255,255,.36); }
.loc-pill text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sub { position: relative; z-index: 1; display: flex; align-items: center; gap: 10rpx; font-size: var(--fs-sub); opacity: .92; margin-top: 12rpx; }
.sub .dot { opacity: .6; }

/* 吸顶快捷分类条 */
.quickbar {
  position: sticky; top: 0; z-index: 40;
  display: flex; align-items: center; gap: 16rpx;
  background: var(--bg); padding: 16rpx 0 16rpx 24rpx;
}
.quick-scroll { flex: 1; min-width: 0; white-space: nowrap; }
.quick-row { display: inline-flex; gap: 16rpx; }
.quick-row .chip { flex: 0 0 auto; }
.qfilter {
  flex: 0 0 auto; display: inline-flex; align-items: center; gap: 8rpx;
  margin-right: 24rpx; padding: 14rpx 28rpx; border-radius: var(--r-pill);
  background: var(--surface); border: 2rpx solid var(--line);
  color: var(--ink); font-size: var(--fs-sub); font-weight: 700;
  box-shadow: var(--sh-sm);
}
.qfilter:active { opacity: .85; }

/* 活动流 + 骨架屏 */
.feed { padding: 8rpx 24rpx 0; }
.skl-card {
  background: var(--surface); border-radius: var(--r-card);
  padding: 28rpx; box-shadow: var(--sh); margin-bottom: 24rpx;
}
.skl-title { width: 60%; height: 38rpx; margin-bottom: 22rpx; }
.skl-line { width: 88%; height: 28rpx; margin-bottom: 14rpx; }
.skl-line.short { width: 64%; margin-bottom: 0; }

.src-note { margin: 32rpx 22rpx 8rpx; font-size: var(--fs-cap); color: var(--ink-3); line-height: 1.7; text-align: center; }

/* 发布 FAB（悬浮于 tabBar 之上，弹层之下） */
.fab {
  position: fixed; right: 32rpx;
  bottom: calc(env(safe-area-inset-bottom) + 140rpx);
  z-index: 50;
  height: 88rpx; padding: 0 40rpx; border-radius: var(--r-pill);
  background: var(--grad-btn); color: #fff;
  display: flex; align-items: center; gap: 10rpx;
  font-size: var(--fs-body); font-weight: 700;
  box-shadow: 0 10rpx 28rpx rgba(207, 94, 39, .38);
}
.fab:active { opacity: .92; transform: scale(.95); }
.fab-plus { font-size: var(--fs-title); font-weight: 800; }

/* 筛选底 sheet（遮罩淡入 + 上滑进入） */
.sheet-overlay {
  position: fixed; inset: 0; background: rgba(20,30,30,.4);
  display: flex; align-items: flex-end; justify-content: center; z-index: 60;
  animation: ov-in .2s ease-out;
}
@keyframes ov-in { from { opacity: 0; } to { opacity: 1; } }
.sheet {
  width: 100%; background: var(--surface);
  border-radius: 40rpx 40rpx 0 0; padding: 16rpx 36rpx calc(36rpx + env(safe-area-inset-bottom));
  animation: sheet-up .24s ease-out;
}
@keyframes sheet-up { from { transform: translateY(100%); } to { transform: translateY(0); } }
.sheet-handle { width: 72rpx; height: 8rpx; border-radius: 6rpx; background: var(--line); margin: 10rpx auto 24rpx; }
.sheet-title { font-size: var(--fs-title); font-weight: 800; color: var(--ink); margin-bottom: 28rpx; }
.sheet-sec { margin-bottom: 32rpx; }
.ss-label { font-size: var(--fs-sub); font-weight: 700; color: var(--ink-2); margin-bottom: 18rpx; }
.sheet-acts { display: flex; gap: 20rpx; margin-top: 16rpx; }
.sbtn { flex: 1; height: 96rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; font-size: var(--fs-body); font-weight: 700; }
.sbtn.reset { background: var(--surface-2); color: var(--ink-2); }
.sbtn.ok { background: var(--grad-btn); color: #fff; }
.sbtn:active { opacity: .9; }
