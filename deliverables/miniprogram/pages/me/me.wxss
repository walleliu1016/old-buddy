.page { padding-bottom: 32rpx; }
.profile {
  margin: 24rpx; background: linear-gradient(135deg, var(--primary), var(--primary-d));
  border-radius: var(--r-card); padding: 36rpx; color: #fff; display: flex; align-items: center; gap: 24rpx; box-shadow: var(--sh);
}
.avatar { width: 100rpx; height: 100rpx; border-radius: 50%; background: rgba(255,255,255,.2); display: flex; align-items: center; justify-content: center; }
.pn { font-size: 42rpx; font-weight: 800; }
.ps { font-size: 24rpx; opacity: .85; margin-top: 4rpx; }

.list { background: var(--surface); margin: 0 24rpx 24rpx; border-radius: var(--r-card); overflow: hidden; box-shadow: 0 2rpx 12rpx rgba(20,45,45,.06); }
.item { display: flex; align-items: center; gap: 20rpx; padding: 30rpx; border-bottom: 1rpx solid var(--line); }
.item:last-child { border-bottom: none; }
.ii { width: 64rpx; height: 64rpx; border-radius: 18rpx; background: var(--primary-soft); color: var(--primary); display: flex; align-items: center; justify-content: center; flex: 0 0 auto; }
.it { flex: 1; font-size: 32rpx; font-weight: 600; }
.iv { font-size: 26rpx; color: var(--ink-3); }
.arrow { font-size: 36rpx; color: var(--ink-3); }
.switch { width: 92rpx; height: 52rpx; border-radius: var(--r-pill); background: var(--line); position: relative; flex: 0 0 auto; transition: background .2s; }
.switch.on { background: var(--primary); }
.switch::after { content: ""; position: absolute; top: 6rpx; left: 6rpx; width: 40rpx; height: 40rpx; border-radius: 50%; background: #fff; transition: left .2s; }
.switch.on::after { left: 46rpx; }

.favitem { display: flex; align-items: center; gap: 20rpx; padding: 30rpx; border-bottom: 1rpx solid var(--line); }
.favitem:last-child { border-bottom: none; }
.fav-empty { text-align: center; color: var(--ink-3); padding: 60rpx; font-size: 30rpx; }
