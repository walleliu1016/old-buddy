.page { padding-bottom: 32rpx; }
.profile {
  margin: 24rpx; background: var(--grad-hero);
  border-radius: var(--r-card); padding: 36rpx; color: #fff; display: flex; align-items: center; gap: 24rpx; box-shadow: var(--sh);
}
.avatar { width: 100rpx; height: 100rpx; border-radius: 50%; background: rgba(255,255,255,.2); display: flex; align-items: center; justify-content: center; }
.avatar-btn { padding: 0; margin: 0; border: none; background: transparent; line-height: 1; width: 100rpx; height: 100rpx; border-radius: 50%; flex: 0 0 auto; }
.avatar-btn::after { border: none; }
.avatar-img { width: 100rpx; height: 100rpx; border-radius: 50%; display: block; }
.pcol { flex: 1; min-width: 0; }
.pn-input { font-size: var(--fs-hero); font-weight: 800; color: #fff; height: 1.4em; }
.pn-ph { color: rgba(255,255,255,.65); font-weight: 600; }
.ps { font-size: var(--fs-cap); opacity: .85; margin-top: 4rpx; }

.list { background: var(--surface); margin: 0 24rpx 24rpx; border-radius: var(--r-card); overflow: hidden; box-shadow: var(--sh-sm); }
.item { display: flex; align-items: center; gap: 20rpx; padding: 30rpx; border-bottom: 1rpx solid var(--line); }
.item:last-child { border-bottom: none; }
.item:active { background: var(--surface-2); }
.ii { width: 64rpx; height: 64rpx; border-radius: 18rpx; background: var(--primary-soft); color: var(--primary); display: flex; align-items: center; justify-content: center; flex: 0 0 auto; }
.it { flex: 1; font-size: var(--fs-body); font-weight: 600; }
.iv { font-size: var(--fs-cap); color: var(--ink-3); }
.arrow { font-size: var(--fs-title); color: var(--ink-3); }

/* 自绘 switch：滑块位移动画 */
.switch { width: 92rpx; height: 52rpx; border-radius: var(--r-pill); background: var(--line); position: relative; flex: 0 0 auto; transition: background .2s; }
.switch.on { background: var(--primary); }
.switch::after { content: ""; position: absolute; top: 6rpx; left: 6rpx; width: 40rpx; height: 40rpx; border-radius: 50%; background: #fff; transition: transform .2s; }
.switch.on::after { transform: translateX(40rpx); }

.favitem { display: flex; align-items: center; gap: 20rpx; padding: 30rpx; border-bottom: 1rpx solid var(--line); }
.favitem:last-child { border-bottom: none; }
.favitem:active { background: var(--surface-2); }
.fav-empty { text-align: center; color: var(--ink-3); padding: 60rpx; font-size: var(--fs-sub); }
