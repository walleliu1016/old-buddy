/* pages/publish/publish.wxss — 复用全局 token，大控件适老化 */
.page { padding: 24rpx 28rpx calc(260rpx + env(safe-area-inset-bottom)); min-height: 100vh; }

/* 顶部双 tab：胶囊轨道式 */
.tabs { display: flex; gap: 6rpx; margin-bottom: 28rpx; padding: 6rpx;
  background: var(--surface-2); border-radius: var(--r-pill); }
.t { flex: 1; height: 84rpx; border-radius: var(--r-pill);
     display: flex; align-items: center; justify-content: center;
     font-size: var(--fs-sub); font-weight: 700; color: var(--ink-2); }
.t.on { background: var(--surface); color: var(--primary); box-shadow: var(--sh-sm); }

.cloud-tip { background: var(--accent-soft); color: var(--accent-d);
  border-radius: var(--r-card); padding: 20rpx 24rpx; font-size: var(--fs-sub);
  line-height: 1.5; margin-bottom: 24rpx; }

/* 表单 */
.form { background: var(--surface); border-radius: var(--r-card);
  box-shadow: var(--sh); padding: 12rpx 28rpx; }
.f-item { padding: 26rpx 0; border-bottom: 2rpx solid var(--line); }
.f-item:last-child { border-bottom: none; }
.f-label { font-size: var(--fs-sub); font-weight: 700; color: var(--ink); margin-bottom: 16rpx; }
.req { color: var(--primary); margin-left: 6rpx; }

.f-input { height: 96rpx; background: var(--surface-2); border-radius: var(--r-btn);
  padding: 0 28rpx; font-size: var(--fs-body); }
.f-input.mt { margin-top: 16rpx; }
.ph { color: var(--ink-3); }
.f-area { width: 100%; min-height: 220rpx; background: var(--surface-2);
  border-radius: 24rpx; padding: 24rpx 28rpx; font-size: var(--fs-body); line-height: 1.5; }

.duo { display: flex; gap: 16rpx; }
.picker { flex: 1; height: 96rpx; background: var(--surface-2); border-radius: var(--r-btn);
  display: flex; align-items: center; padding: 0 28rpx; font-size: var(--fs-body); color: var(--ink); }

/* 提交区：实底固定条，避免表单文字透过/盖住按钮 */
.safe-bottom { position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
  padding: 16rpx 28rpx calc(env(safe-area-inset-bottom) + 16rpx);
  background: var(--bg); border-top: 1rpx solid var(--line); }
.submit { width: 100%; }
.audit-note { text-align: center; font-size: var(--fs-cap); color: var(--ink-3);
  margin-top: 14rpx; line-height: 1.5; }

/* 我发布的 */
.plist { display: flex; flex-direction: column; gap: 20rpx; }
.p-head { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.p-title { font-size: var(--fs-body); font-weight: 700; color: var(--ink);
  flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.p-status { flex-shrink: 0; font-size: var(--fs-cap); font-weight: 700;
  padding: 6rpx 18rpx; border-radius: var(--r-pill);
  background: var(--surface-2); color: var(--ink-3); }
.p-status.ok { background: var(--free-soft); color: var(--free); }
.p-meta { font-size: var(--fs-sub); color: var(--ink-2); margin-top: 12rpx; line-height: 1.5; }
.p-acts { display: flex; justify-content: flex-end; margin-top: 16rpx; }
.pbtn { font-size: var(--fs-sub); font-weight: 700; padding: 14rpx 34rpx;
  border-radius: var(--r-pill); }
.pbtn.off { background: var(--primary-soft); color: var(--primary); }
.pbtn:active { opacity: .85; }
